PUBLIC_URL=http://localhost:3000
PORT=3000
DATA_DIR=./data
# First administrator (created on the first start only).
ADMIN_USERNAME=admin
ADMIN_NAME=System Administrator
ADMIN_EMAIL=
# Set your own strong password (at least 8 characters) before the first startup. No default password exists.
ADMIN_PASSWORD=
# The operator company (WSP) created on the first start; client companies are added under Account → Company.
COMPANY_NAME=
COMPANY_NAME_CN=
COMPANY_CODE=
# Building in mainland China: uncomment to use mirrors for the Node image and npm packages.
# NODE_IMAGE=docker.m.daocloud.io/library/node:24-bookworm-slim
# NPM_REGISTRY=https://registry.npmmirror.com
# Administrators (System, Chief and User Admins) must use an authenticator app. Only turn this off for local testing.
REQUIRE_ADMIN_MFA=true
# Attachment malware scanning via ClamAV (clamd). compose.production.yaml runs it; leave empty to skip scanning in local tests.
CLAMAV_HOST=
# CLAMAV_IMAGE=docker.m.daocloud.io/clamav/clamav:stable
# AiWSP Assistant: where your client-answering agent listens (see docs/aiwsp/assistant.md). Empty = questions go to WSP staff.
AGENT_URL=
AGENT_TOKEN=
# Hold answers whose confidence is below this for review by a WSP professional (0 = off).
AGENT_REVIEW_BELOW=0
# Reminders (run once a day after REMINDER_HOUR in APP_TIMEZONE): items due within DUE_SOON_DAYS, overdue items (then weekly),
# approval steps waiting longer than APPROVAL_REMIND_DAYS, and temporary accounts a week before they expire.
# APP_TIMEZONE=Asia/Shanghai
# REMINDER_HOUR=8
# DUE_SOON_DAYS=2
# APPROVAL_REMIND_DAYS=3
